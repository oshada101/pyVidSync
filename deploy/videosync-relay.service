# Install: copy to /etc/systemd/system/, then `systemctl enable --now videosync-relay`.
# To expose the port directly (plain ws://, no Caddy), override HOST in a drop-in so
# auto-updates of this file keep it:
#   /etc/systemd/system/videosync-relay.service.d/override.conf
#   [Service]
#   Environment=HOST=0.0.0.0
[Unit]
Description=Video Sync relay server
After=network-online.target
Wants=network-online.target

[Service]
Environment=HOST=127.0.0.1 PORT=1999
ExecStart=/opt/videosync/venv/bin/python /opt/videosync/relay_server.py
Restart=on-failure
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=96M

[Install]
WantedBy=multi-user.target
